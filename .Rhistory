size = 0.9) +
geom_violin(data = df_hmm_last,
mapping = aes(x = Stage,
y = ALSFRS_R_Total,
fill = Stage)) +
coord_flip()
ggplot(df_hmm_last, aes(x = Stage, y = ALSFRS_R_Total, fill = Stage)) +
#  geom_boxplot(outlier.shape = NA, alpha = 0.8) +
geom_violin() +
labs(
x = "HMM Stage",
y = "ALSFRS-R Total Score"
) +
scale_fill_brewer(palette = "Set2") +
theme_bw() +
theme(panel.grid = element_blank(),
