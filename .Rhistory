# antihypertensive_dementia: end-to-end 분석 스크립트
# -------------------------------------------------------
# 환경 준비
library(tidyverse)
# 데이터 읽기
df <- readr::read_csv("data/antihypertensive_dementia.csv")
glimpse(df)
# 기본 점검: 결측치
na_count <- sapply(df, function(x) sum(is.na(x)))
na_count
# 정제 & 가공
df <- df %>%
# 범주형 변수(형변환, 레벨 조정)
mutate(sex = fct_collapse(factor(sex),
Male = c("M","Male"),
Female = c("F","Female")),
insurance_quartile = factor(insurance_quartile),
depression_dx = factor(depression_dx),
medication_adherence = fct_collapse(factor(medication_adherence), High = c("H", "High"), Low = c("L", "Low")),
dementia_dx = fct_collapse(factor(dementia_dx),
Yes = c("yes", "Yes"),
No = c("no", "No"))
)
# 정제 & 가공
# 이상치 완화
df$bmi = ifelse(df$bmi < 15, 15, df$bmi)
# 결측치(missing data) 처리
df = df[complete.cases(df),]
# 저장
write_csv(df, "data/antihypertensive_dementia_clean.csv")
df = read_csv("data/antihypertensive_dementia_clean.csv")
t.test(cognitive_score ~ dementia_dx, data = df)
knitr::opts_chunk$set(echo = TRUE, eval = FALSE, message = FALSE, warning = FALSE)
set.seed(42)
t.test(cognitive_score ~ dementia_dx, data = df)
# 치매 진단 여부와 항고혈압제 복용의 지속성 사이에 관련성이 있는가?
tab_df = table(df$medication_adherence, df$dementia_dx)
tab_df
df = read_csv("data/antihypertensive_dementia_clean.csv")
t.test(cognitive_score ~ dementia_dx, data = df)
# 치매 진단 여부와 항고혈압제 복용의 지속성 사이에 관련성이 있는가?
tab_df = table(df$medication_adherence, df$dementia_dx)
tab_df
chisq.test(tab_df)
# 치매 진단 여부에 따라 기저(baseline) 인지 점수에 차이가 있는가?
t.test(cognitive_score ~ dementia_dx, data = df)
chisq.test(tab_df)
names(df)
# 항고혈압제 복용이 우울증 진단 여부와 관련이 있는가?
tab_df = table(df$depression_dx, df$dementia_dx)
tab_df
chisq.test(tab_df)
tab = table(df$insurance_quartile, df$dementia_dx)
tab
chisq.test(tab)
names(df)
# baseline 인지 점수(cognitive_score)에 영향을 미치는 요인은 무엇인가?
lm(cognitive_score ~ age + sex + insurance_quartile + num_comorbidities + bmi + depression_dx + outpatient_visits, data = df)
# baseline 인지 점수(cognitive_score)에 영향을 미치는 요인은 무엇인가?
lm_fit = lm(cognitive_score ~ age + sex + insurance_quartile + num_comorbidities + bmi + depression_dx + outpatient_visits, data = df)
summary(lm_fit)
28.19/1.47
# 항고혈압제 지속적 복용군과 비복용군의 치매 발생 누적 위험은 차이가 있는가?
km_fit <- survfit(Surv(time_to_dementia, event) ~ medication_adherence, data = df)
# 항고혈압제 지속적 복용군과 비복용군의 치매 발생 누적 위험은 차이가 있는가?
library(survival)
km_fit <- survfit(Surv(time_to_dementia, event) ~ medication_adherence, data = df)
km_fit
summary(km_fit)
ggsurvplot(km_fit, data = df, pval = TRUE, risk.table = TRUE)
library(survminer)
ggsurvplot(km_fit, data = df, pval = TRUE, risk.table = TRUE)
# baseline 인지 점수(cognitive_score)에 영향을 미치는 요인은 무엇인가?
lm_fit = lm(cognitive_score ~ age + sex + insurance_quartile + num_comorbidities + bmi + depression_dx + outpatient_visits, data = df)
summary(lm_fit)
km_fit <- survfit(Surv(time_to_dementia, event) ~ medication_adherence, data = df)
ggsurvplot(km_fit, data = df, pval = TRUE, risk.table = TRUE)
?survdiff
survdiff(Surv(time_to_dementia, event) ~ medication_adherence, data = df)
296+123
67/419
296*0.16
123*0.16
# 항고혈압제 지속적 복용 여부는 치매 발생에 영향을 미치는가? 얼마나 영향을 미치는가? Cox 비례위험 모델로 추정해보라.
cox_fit <- coxph(Surv(time_to_dementia, event) ~ medication_adherence, data = df)
summary(cox_fit)
# 항고혈압제 지속적 복용 여부는 치매 발생에 영향을 미치는가? 얼마나 영향을 미치는가? Cox 비례위험 모델로 추정해보라.
cox_fit <- coxph(Surv(time_to_dementia, event) ~ medication_adherence, data = df)
summary(cox_fit)
