mapping = aes(x = Stage,
y = ALSFRS_R_Total))
ggplot(emm_df_hmm, aes(x = Stage, y = emmean)) +
geom_point(size = 1, color = "blue") +
geom_errorbar(aes(x = Stage,
ymin = lower.CL,
ymax = upper.CL),
size = 0.9) +
geom_violin(data = df_hmm_last,
mapping = aes(x = factor(Stage),
y = ALSFRS_R_Total))
ggplot(emm_df_hmm, aes(x = Stage, y = emmean)) +
