n <- 2000
# Race
race <- sample(c("White","Black"), n, replace=TRUE, prob=c(0.6,0.4))
# 기본 특성
age <- round(rnorm(n, mean=60, sd=10))
chronic_count <- rpois(n, 2)
# True clinical need: Black 그룹 확률을 더 높임
lin_true <- -7 + 0.06*age + 0.9*chronic_count + ifelse(race=="Black", 1.2, 0)
true_prob <- plogis(lin_true)
true_need <- rbinom(n, 1, true_prob)
# Past cost: Black 그룹에서 구조적 차별을 더 강하게 반영
# (동일 true_need 수준에서도 White > Black 지출 차이 크게)
past_cost <- 2000 + 400*chronic_count + 60*age +
rnorm(n, 0, 500) +
ifelse(race=="Black", -1500, 0)
# 데이터프레임
df <- data.frame(race, age, chronic_count, past_cost, true_need)
# 로지스틱 회귀 모델 (race 제외)
m1 <- glm(true_need ~ age + chronic_count + past_cost,
data=df, family=binomial)
# 예측 확률
df$pred_prob <- predict(m1, type="response")
# 성능 비교 (인종별 AUC)
library(pROC)
auc_white <- roc(df$true_need[df$race=="White"],
df$pred_prob[df$race=="White"])$auc
auc_black <- roc(df$true_need[df$race=="Black"],
df$pred_prob[df$race=="Black"])$auc
c(auc_white=auc_white, auc_black=auc_black)
aggregate(cbind(true_need, pred_prob) ~ race, data=df, mean)
ㅣㅏ
df
names(df)
## ---- simulate_biased_data ----------------------------------------------------
set.seed(2025)
n <- 3000
# 1) 기본 인구통계/임상 변수
race  <- sample(c("White","Black"), n, replace = TRUE, prob = c(0.6, 0.4))
sex   <- sample(c("Male","Female"), n, replace = TRUE)
age   <- pmin(pmax(round(rnorm(n, mean = 60, sd = 10)), 20), 90)
chronic_count     <- rpois(n, lambda = 2)                                 # 만성질환 수
dx_count          <- pmax(1, round(rnorm(n, mean = 8 + 1.2*chronic_count, sd = 3))) # 진단코드 수
drug_count        <- pmax(0, rpois(n, lambda = 4 + 0.8*chronic_count))    # 약물 수
inpatient_history <- rbinom(n, 1, plogis(-1 + 0.35*chronic_count))        # 입원 이력(0/1)
# 2) true_need (의학적 필요; Black 그룹 위험↑)
lin_true <- -7 +
0.06*age +
0.70*chronic_count +
0.45*inpatient_history +
0.03*dx_count +
0.03*drug_count +
ifelse(race == "Black", 1.0, 0)   # 인종 차이 명시 (실제 위험 차이)
true_prob <- plogis(lin_true)
true_need <- rbinom(n, 1, true_prob)
# 3) past_cost (과거 비용; Black 그룹에서 필요/임상 반영이 약하고, 절대수준도 낮음)
#    - White: 임상/필요 → 비용 반영 강함
#    - Black: 임상/필요 → 비용 반영 약함 + 전반적 비용 낮음(구조적 차별 가정)
clinical_component <- 40*age + 320*chronic_count + 20*dx_count + 30*drug_count + 1500*inpatient_history
need_boost_white   <- 2500   # 필요의 비용 반영 강함
need_boost_black   <- 1000   # 필요의 비용 반영 약함
past_cost_raw <-
1000 +
ifelse(race == "Black",
0.60*clinical_component + need_boost_black*true_need - 800,  # Black: 낮고 둔감
1.00*clinical_component + need_boost_white*true_need)        # White: 높고 민감
past_cost <- round(pmax(200, past_cost_raw + rnorm(n, 0, 600)))        # 잡음 추가 + 하한 보정
# 4) 최종 데이터프레임 (요청하신 9개 변수만)
df <- data.frame(
race, sex, age,
chronic_count, dx_count, drug_count,
inpatient_history, past_cost, true_need
)
# 간단 확인
summary(df)
table(df$race)
tapply(df$true_need, df$race, mean)   # 인종별 실제 필요 발생률
tapply(df$past_cost,  df$race, mean)  # 인종별 과거 비용 평균
names(df)
## 1) 로지스틱 회귀 적합 (race 제외)
m_logit <- glm(true_need ~ age + chronic_count + dx_count + drug_count + inpatient_history + past_cost,
data = df, family = binomial)
summary(m_logit)
## 2) 예측 확률
df$pred_prob <- predict(m_logit, type = "response")
## 3) 인종별 AUC 비교
auc_all   <- roc(df$true_need, df$pred_prob)$auc
auc_white <- roc(df$true_need[df$race=="White"], df$pred_prob[df$race=="White"])$auc
auc_black <- roc(df$true_need[df$race=="Black"], df$pred_prob[df$race=="Black"])$auc
c(auc_all = auc_all, auc_white = auc_white, auc_black = auc_black)
## 4) 임계값 기준 성능(민감도/특이도/정확도) 비교
thr <- 0.5
df <- df %>% mutate(pred_label = as.integer(pred_prob >= thr))
