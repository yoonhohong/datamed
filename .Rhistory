?performance
str(perf_obj)
# cutoff 값
target_cutoff <- 0.5
# performance 객체 생성 (예: TPR vs cutoff)
perf <- performance(pred, "tpr", "cutoff")
# cutoff 값들
cutoffs <- perf@x.values[[1]]
# performance 객체 생성 (예: TPR vs cutoff)
perf <- performance(pred_obj, "tpr", "cutoff")
# cutoff 값들
cutoffs <- perf@x.values[[1]]
# TPR 값들
tpr_values <- perf@y.values[[1]]
# 가장 가까운 cutoff 인덱스 찾기
index <- which.min(abs(cutoffs - target_cutoff))
# 해당 cutoff에서의 TPR 값
tpr_at_cutoff <- tpr_values[index]
cat("TPR at cutoff", target_cutoff, ":", tpr_at_cutoff, "\n")
# performance 객체 생성 (예: TPR vs cutoff)
perf <- performance(pred_obj, "sens", "cutoff")
# cutoff 값들
cutoffs <- perf@x.values[[1]]
# TPR 값들
tpr_values <- perf@y.values[[1]]
# 가장 가까운 cutoff 인덱스 찾기
index <- which.min(abs(cutoffs - target_cutoff))
# 해당 cutoff에서의 TPR 값
tpr_at_cutoff <- tpr_values[index]
cat("TPR at cutoff", target_cutoff, ":", tpr_at_cutoff, "\n")
# 해당 cutoff에서의 TPR 값
sens_at_cutoff <- sens_values[index]
# performance 객체 생성 (예: TPR vs cutoff)
perf <- performance(pred_obj, "sens", "cutoff")
# cutoff 값들
cutoffs <- perf@x.values[[1]]
# TPR 값들
sens_values <- perf@y.values[[1]]
# 가장 가까운 cutoff 인덱스 찾기
index <- which.min(abs(cutoffs - target_cutoff))
# 해당 cutoff에서의 TPR 값
sens_at_cutoff <- sens_values[index]
cat("Sensitivity at cutoff", target_cutoff, ":", sens_at_cutoff, "\n")
# performance 객체 생성 (예: TPR vs cutoff)
perf <- performance(pred_obj, "spec", "cutoff")
# cutoff 값들
cutoffs <- perf@x.values[[1]]
# TPR 값들
spec_values <- perf@y.values[[1]]
# 가장 가까운 cutoff 인덱스 찾기
index <- which.min(abs(cutoffs - target_cutoff))
# 해당 cutoff에서의 TPR 값
spec_at_cutoff <- spec_values[index]
cat("Specificity at cutoff", target_cutoff, ":", spec_at_cutoff, "\n")
# acc
# performance 객체 생성 (예: TPR vs cutoff)
perf <- performance(pred_obj, "acc", "cutoff")
# cutoff 값들
cutoffs <- perf@x.values[[1]]
# acc
